# ClauseGuard AI Environment Configuration

# Application Mode
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ClauseGuard AI"
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite fallback option for lightweight development: sqlite+aiosqlite:///./clauseguard.db
# PostgreSQL option: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/clauseguard
DATABASE_URL=sqlite+aiosqlite:///./clauseguard.db

# Redis & Celery/Worker
REDIS_URL=redis://localhost:6379/0

# JWT & Authentication
JWT_SECRET=clauseguard-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AI Provider Credentials (If blank, system gracefully uses intelligent mock AI provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=mock

# Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=./storage/documents

# Server Port Settings
PORT=8000
FRONTEND_URL=http://localhost:5173
